{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/data-project",
      "destination": "/index.html"
    },
    {
      "source": "/data-project/",
      "destination": "/index.html"
    },
    {
      "source": "/mydashboard",
      "destination": "/index.html"
    },
    {
      "source": "/mydashboard/:page*",
      "destination": "/index.html"
    }
  ]
}
